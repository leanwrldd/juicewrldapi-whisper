{
  "name": "wrld-sync",
  "version": "1.0.6",
  "description": "WRLD Sync desktop app",
  "author": "leanwrldd",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.leanwrldd.wrldsync",
    "productName": "WRLD Sync",
    "publish": {
      "provider": "github",
      "owner": "leanwrldd",
      "repo": "juicewrldapi-whisper"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      "!pyruntime/**/*",
      "!pyruntime_tmp/**/*",
      "!dist/**/*",
      "!build/**/*"
    ],
    "extraResources": [
      {
        "from": "../static",
        "to": "static"
      },
      {
        "from": "../app.py",
        "to": "app.py"
      },
      {
        "from": "pyruntime",
        "to": "pyruntime"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
